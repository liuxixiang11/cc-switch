     params
 }
+
+fn sanitize_parameter_schema(schema: &mut Value, is_root: bool) {
+    let Value::Object(obj) = schema else {
+        return;
+    };
+    if is_root && obj.get("type").and_then(|v| v.as_str()) != Some("object") {
+        obj.insert("type".to_string(), json!("object"));
+    }
+    let strict_marker = obj.get("additionalProperties") == Some(&json!(false));
+    let valid_required = obj
+        .get("required")
+        .is_some_and(|required| required.is_array());
+    if !valid_required {
+        if strict_marker {
+            obj.remove("additionalProperties");
+        }
+        obj.insert("required".to_string(), json!([]));
+    }
+    if let Some(properties) = obj
+        .get_mut("properties")
+        .and_then(|v| v.as_object_mut())
+    {
+        for value in properties.values_mut() {
+            sanitize_parameter_schema(value, false);
+        }
+    }
+    if let Some(items) = obj.get_mut("items") {
+        if let Some(array) = items.as_array_mut() {
+            for value in array.iter_mut() {
+                sanitize_parameter_schema(value, false);
+            }
+        } else {
+            sanitize_parameter_schema(items, false);
+        }
+    }
+}
